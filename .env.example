# Copy this file to .env.local and fill in the two values from
# Supabase dashboard -> Project Settings -> API (or "API Keys").
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# the "anon" key, or the newer "publishable" key (sb_publishable_...). Never use the service_role / secret key here.
VITE_SUPABASE_ANON_KEY=YOUR-ANON-OR-PUBLISHABLE-KEY
